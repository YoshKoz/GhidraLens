<Page
    x:Class="GhidraLens.StaticMappingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,8,24,24" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Modules mapped between the static program and the live trace" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button Click="Refresh_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" /><TextBlock Text="Refresh" /></StackPanel></Button>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="ModulesText" FontFamily="Cascadia Mono, Consolas" FontSize="15" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="16">
            <StackPanel Spacing="8">
                <TextBlock Text="Static to dynamic" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox x:Name="StaticAddr" Header="Static (program) address" FontSize="18" />
                <Button Content="Map" Click="ToDynamic_Click" />
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="Dynamic to static" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBox x:Name="DynamicAddr" Header="Dynamic (trace) address" FontSize="18" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Map" Click="ToStatic_Click" />
                    <Button Content="Open in CodeBrowser" Click="OpenStatic_Click" />
                </StackPanel>
            </StackPanel>
            <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Name="ResultText" FontFamily="Cascadia Mono, Consolas" FontSize="15" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Grid>
</Page>
