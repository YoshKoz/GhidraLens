<Window
    x:Class="GhidraLens.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/GhidraLens.png" Width="20" Height="20" />
                <TextBlock Text="Ghidra Lens" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="4,0,16,4">
            <MenuBar>
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="Open program..." Click="OpenProgram_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Import file..." Click="ImportFile_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="I" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open project..." Click="OpenProject_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Save" Click="Save_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Save all" Click="SaveAll_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Shift" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Close program" Click="CloseProgram_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="Exit_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="F4" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem Text="Rename function..." Click="Rename_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="L" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Set comment..." Click="Comment_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="Number3" Modifiers="Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Set prototype..." Click="Prototype_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control,Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Tag function..." Click="Tag_Click" />
                    <MenuFlyoutItem Text="Add bookmark..." Click="Bookmark_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="D" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Go to address..." Click="Goto_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="G" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <MenuBarItem Title="Search">
                    <MenuFlyoutItem Text="Functions..." Click="SearchFunctions_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Strings..." Click="SearchStrings_Click" />
                    <MenuFlyoutItem Text="Instructions..." Click="SearchInstructions_Click" />
                    <MenuFlyoutItem Text="Byte pattern..." Click="SearchBytes_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="B" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>

                <MenuBarItem Title="Project">
                    <MenuFlyoutItem Text="Project files" Click="ProjectFiles_Click" />
                    <MenuFlyoutItem Text="Open programs" Click="OpenPrograms_Click" />
                    <MenuFlyoutItem Text="Bookmarks" Click="Bookmarks_Click" />
                    <MenuFlyoutItem Text="Program metadata" Click="Metadata_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Analysis">
                    <MenuFlyoutItem Text="Auto analyze" Click="RunAnalysis_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="A" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Re-analyze" Click="Reanalyze_Click" />
                    <MenuFlyoutItem Text="Analysis status" Click="AnalysisStatus_Click" />
                    <MenuFlyoutItem Text="Analyzers" Click="Analyzers_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Window">
                    <MenuFlyoutItem Text="CodeBrowser" Click="Window_Click" Tag="codebrowser">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number1" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Functions" Click="Window_Click" Tag="functions">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number2" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Time" Click="Window_Click" Tag="time" />
                    <MenuFlyoutItem Text="Static Mappings" Click="Window_Click" Tag="mappings" />
                    <MenuFlyoutItem Text="P-code Stepper" Click="Window_Click" Tag="pcode" />
                </MenuBarItem>

                <MenuBarItem x:Name="ToolsMenu" Title="Tools">
                    <MenuFlyoutItem Text="Reconnect" Click="Connect_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                </MenuBarItem>

                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="Ghidra documentation" Click="GhidraDocs_Click">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F1" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="GhidraMCP documentation" Click="PluginDocs_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Version info" Click="Version_Click" />
                    <MenuFlyoutItem Text="About Ghidra Lens" Click="About_Click" />
                </MenuBarItem>
            </MenuBar>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" />
                <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center" />
                <NumberBox x:Name="PortBox" Value="8089" Minimum="1" Maximum="65535" Width="100"
                           SpinButtonPlacementMode="Hidden" />
                <Button Content="Connect" Click="Connect_Click" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="2" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="260"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ProgramItem" Content="Program" Tag="page:program">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CodeBrowserItem" Content="CodeBrowser" Tag="page:codebrowser">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FunctionsItem" Content="Functions" Tag="page:functions">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Strings" Tag="list:list_strings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Imports" Tag="list:list_imports">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Exports" Tag="list:list_exports">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE898;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Segments" Tag="list:list_segments">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Classes" Tag="list:list_classes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Globals" Tag="list:list_globals">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Debugger" />
                <NavigationViewItem x:Name="TimeItem" Content="Time" Tag="page:time">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MappingsItem" Content="Static Mappings" Tag="page:mappings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PcodeItem" Content="P-code Stepper" Tag="page:pcode">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="All tools" />
                <NavigationViewItem x:Name="ToolsRoot" Content="Tools" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
