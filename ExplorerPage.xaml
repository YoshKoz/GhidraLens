<Page
    x:Class="GhidraLens.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GhidraLens">
    <Grid Padding="24,8,24,24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <AutoSuggestBox x:Name="FilterBox" PlaceholderText="Filter" QueryIcon="Find"
                            FontSize="18" TextChanged="FilterBox_TextChanged" />
            <ListView x:Name="ItemsList" Grid.Row="1" FontSize="18" SelectionChanged="ItemsList_SelectionChanged" DoubleTapped="ItemsList_DoubleTapped"
                      ItemsSource="{x:Bind Visible, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Row">
                        <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" Margin="0,6" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="CountText" Grid.Row="2" Opacity="0.7" />
        </Grid>

        <Border Grid.Column="1" CornerRadius="8" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <RichTextBlock x:Name="DetailText" FontFamily="Cascadia Mono, Consolas" FontSize="17"
                           IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <ProgressRing x:Name="Busy" Grid.ColumnSpan="2" Width="64" Height="64" IsActive="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
