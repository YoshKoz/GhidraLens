<Page
    x:Class="GhidraLens.CodeBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GhidraLens">
    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="Back_Click" ToolTipService.ToolTip="Back (Alt+Left)">
                <FontIcon Glyph="&#xE72B;" />
                <Button.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="Left" /></Button.KeyboardAccelerators>
            </Button>
            <Button Click="Forward_Click" ToolTipService.ToolTip="Forward (Alt+Right)">
                <FontIcon Glyph="&#xE72A;" />
                <Button.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="Right" /></Button.KeyboardAccelerators>
            </Button>
            <TextBox x:Name="AddressBox" Width="260" FontSize="18" PlaceholderText="Address (hex)" KeyDown="AddressBox_KeyDown" />
            <Button Content="Go" Style="{StaticResource AccentButtonStyle}" Click="Go_Click" />
            <TextBlock x:Name="FunctionTitle" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="8" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Listing" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="8,0" />
                    <ListView x:Name="ListingView" Grid.Row="1" ItemsSource="{x:Bind Listing}" SelectionChanged="Listing_SelectionChanged"
                              DoubleTapped="Listing_DoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="8,0" /></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Row">
                                <TextBlock Text="{x:Bind Text}" FontFamily="Cascadia Mono, Consolas" FontSize="16" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Decompile" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DecompileText" FontFamily="Cascadia Mono, Consolas" FontSize="16" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="BytesTitle" Text="Bytes" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="HexText" FontFamily="Cascadia Mono, Consolas" FontSize="16" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Border>

        <ProgressRing x:Name="Busy" Grid.RowSpan="3" Width="56" Height="56" IsActive="False" />
    </Grid>
</Page>
